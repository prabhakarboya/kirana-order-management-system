// Prisma Schema for FMCG Distributor Ordering Platform (Company A, Jabalpur)
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  role         String    @default("RETAILER") // RETAILER, SALESMAN, DESK, ADMIN
  name         String
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  retailer  Retailer?
  auditLogs AuditLog[]

  @@map("users")
}

model Retailer {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName     String
  ownerName    String
  phone        String
  address      String
  creditLimit  Float     @default(50000.0)
  creditUsed   Float     @default(0.0)
  lastOrderAt  DateTime?
  salesmanName String?   @default("Rajesh Sharma")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prices  RetailerPrice[]
  orders  Order[]
  aliases Alias[]

  @@map("retailers")
}

model Sku {
  code          String   @id
  name          String
  brand         String
  category      String
  unitLabel     String   // e.g. "case of 96", "case of 20", "case of 40"
  piecesPerCase Int      @default(1)
  dealerPrice   Float    // Per-piece price as per sample data
  casePrice     Float    // dealerPrice * piecesPerCase
  gstIncluded   Boolean  @default(false)
  gstRate       Float    @default(18.0)
  stockCases    Int      @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  retailerPrices RetailerPrice[]
  schemes        Scheme[]
  orderLines     OrderLine[]
  aliases        Alias[]

  @@map("skus")
}

model RetailerPrice {
  id          String   @id @default(uuid())
  retailerId  String
  skuCode     String
  dealerPrice Float
  casePrice   Float
  retailer    Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sku         Sku      @relation(fields: [skuCode], references: [code], onDelete: Cascade)

  @@unique([retailerId, skuCode])
  @@map("retailer_prices")
}

model Scheme {
  id          String   @id @default(uuid())
  skuCode     String
  sku         Sku      @relation(fields: [skuCode], references: [code], onDelete: Cascade)
  type        String   // FREE_GOODS, SLAB_PERCENT
  title       String
  description String
  configJson  String   // JSON string with buyQty, freeQty, minQty, discountPercent
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("schemes")
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  clientOrderId   String?  @unique // Idempotency key for offline salesman order sync
  retailerId      String
  retailer        Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  status          String   @default("PENDING_DESK_REVIEW") // PENDING_DESK_REVIEW, CREDIT_HOLD, APPROVED, REJECTED, DISPATCHED
  source          String   @default("APP") // APP, AI_TEXT, AI_VOICE, AI_PHOTO, SALESMAN_OFFLINE
  rawMessage      String?
  subtotal        Float
  discountTotal   Float    @default(0.0)
  gstTotal        Float
  grandTotal      Float
  totalSavings    Float    @default(0.0)
  creditApproved  Boolean  @default(true)
  stockDeducted   Boolean  @default(false)
  rejectionReason String?
  tallyExported   Boolean  @default(false)
  tallyVoucherNo  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines     OrderLine[]
  auditLogs AuditLog[]

  @@map("orders")
}

model OrderLine {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuCode        String
  sku            Sku      @relation(fields: [skuCode], references: [code], onDelete: Restrict)
  qtyCases       Int
  freeCases      Int      @default(0)
  unitPrice      Float    // Per-case price
  discountAmount Float    @default(0.0)
  gstRate        Float
  gstAmount      Float
  lineTotal      Float
  schemeApplied  String?
  createdAt      DateTime @default(now())

  @@map("order_lines")
}

model Alias {
  id         String    @id @default(uuid())
  retailerId String?
  retailer   Retailer? @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  phrase     String
  skuCode    String
  sku        Sku       @relation(fields: [skuCode], references: [code], onDelete: Cascade)
  confidence Float     @default(1.0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([retailerId, phrase])
  @@map("aliases")
}

model AuditLog {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  details   String?
  timestamp DateTime @default(now())

  @@map("audit_logs")
}
