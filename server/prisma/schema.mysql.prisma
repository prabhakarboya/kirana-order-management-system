// Prisma Schema for MySQL 8 Production Deployment (Company A, Jabalpur)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  role         String    @default("RETAILER")
  name         String
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  retailer  Retailer?
  auditLogs AuditLog[]

  @@map("users")
}

model Retailer {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName     String
  ownerName    String
  phone        String
  address      String
  creditLimit  Decimal   @default(50000.00) @db.Decimal(12, 2)
  creditUsed   Decimal   @default(0.00) @db.Decimal(12, 2)
  lastOrderAt  DateTime?
  salesmanName String?   @default("Rajesh Sharma")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prices  RetailerPrice[]
  orders  Order[]
  aliases Alias[]

  @@map("retailers")
}

model Sku {
  code          String   @id
  name          String
  brand         String
  category      String
  unitLabel     String
  piecesPerCase Int      @default(1)
  dealerPrice   Decimal  @db.Decimal(10, 2)
  casePrice     Decimal  @db.Decimal(10, 2)
  gstIncluded   Boolean  @default(false)
  gstRate       Decimal  @default(18.00) @db.Decimal(5, 2)
  stockCases    Int      @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  retailerPrices RetailerPrice[]
  schemes        Scheme[]
  orderLines     OrderLine[]
  aliases        Alias[]

  @@map("skus")
}

model RetailerPrice {
  id          String   @id @default(uuid())
  retailerId  String
  skuCode     String
  dealerPrice Decimal  @db.Decimal(10, 2)
  casePrice   Decimal  @db.Decimal(10, 2)
  retailer    Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sku         Sku      @relation(fields: [skuCode], references: [code], onDelete: Cascade)

  @@unique([retailerId, skuCode])
  @@map("retailer_prices")
}

model Scheme {
  id          String   @id @default(uuid())
  skuCode     String
  sku         Sku      @relation(fields: [skuCode], references: [code], onDelete: Cascade)
  type        String
  title       String
  description String
  configJson  String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("schemes")
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  clientOrderId   String?  @unique
  retailerId      String
  retailer        Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  status          String   @default("PENDING_DESK_REVIEW")
  source          String   @default("APP")
  rawMessage      String?  @db.Text
  subtotal        Decimal  @db.Decimal(12, 2)
  discountTotal   Decimal  @default(0.00) @db.Decimal(12, 2)
  gstTotal        Decimal  @db.Decimal(12, 2)
  grandTotal      Decimal  @db.Decimal(12, 2)
  totalSavings    Decimal  @default(0.00) @db.Decimal(12, 2)
  creditApproved  Boolean  @default(true)
  stockDeducted   Boolean  @default(false)
  rejectionReason String?
  tallyExported   Boolean  @default(false)
  tallyVoucherNo  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines     OrderLine[]
  auditLogs AuditLog[]

  @@map("orders")
}

model OrderLine {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuCode        String
  sku            Sku      @relation(fields: [skuCode], references: [code], onDelete: Restrict)
  qtyCases       Int
  freeCases      Int      @default(0)
  unitPrice      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  gstRate        Decimal  @db.Decimal(5, 2)
  gstAmount      Decimal  @db.Decimal(10, 2)
  lineTotal      Decimal  @db.Decimal(10, 2)
  schemeApplied  String?
  createdAt      DateTime @default(now())

  @@map("order_lines")
}

model Alias {
  id         String    @id @default(uuid())
  retailerId String?
  retailer   Retailer? @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  phrase     String
  skuCode    String
  sku        Sku       @relation(fields: [skuCode], references: [code], onDelete: Cascade)
  confidence Decimal   @default(1.00) @db.Decimal(3, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([retailerId, phrase])
  @@map("aliases")
}

model AuditLog {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())

  @@map("audit_logs")
}
